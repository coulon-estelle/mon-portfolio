---
import type { projets } from '../data/projets';
import { Image } from 'astro:assets';
interface Props {
  projet: (typeof projets)[number];
}
const { projet } = Astro.props;
---

<article class:list={['project', projet.style]}>
  <div class="project-visual">
    {projet.image ? (
      <Image
        src={projet.image}
        alt={`Planche de présentation du projet ${projet.nom}`}
        loading="lazy"
        width="900"
        widths={[400, 800, 1200]}
        sizes="(max-width: 700px) 90vw, (max-width: 1000px) 30vw, 380px"
        format="webp"
        quality={88}
      />
    ) : (
      <div class="project-art" aria-label={`Emplacement du visuel ${projet.nom}`}>
        <span class="art-orbit" aria-hidden="true"></span>
        <span class="art-name">{projet.nom}</span>
        <span class="art-caption">{projet.accroche}</span>
        <span class="visual-note">Visuel à venir</span>
      </div>
    )}
  </div>
  <div class="project-content">
    <p class="project-meta">
      {projet.categorie.replace(' · ', ' — ')} — {projet.annee}
    </p>
    <h3>
      <a
        class="project-page-link"
        href={`/projets/${projet.id}`}
        aria-label={`Découvrir le projet ${projet.nom}`}
      >
        {projet.nom}
      </a>
    </h3>
    <p class="project-description">{projet.description}</p>
  </div>
</article>
