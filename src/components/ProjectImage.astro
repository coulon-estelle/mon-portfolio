---
// ===== COMPOSANTS : PREPARATION ASTRO =====
// Les imports et les données de ce bloc sont traités par Astro, avant le HTML envoyé au navigateur.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// ===== COMPOSANTS : PROPRIETES TYPEES =====
// Décrit les paramètres que les pages peuvent transmettre au composant.
interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  eager?: boolean;
  class?: string;
}
const { src, alt, width = 1000, eager = false, class: className } = Astro.props;
---
<!-- ===== IMAGES : OPTIMISATION ASTRO ===== -->
<!-- Produit des images WebP et plusieurs résolutions à partir des fichiers importés. -->


<!-- ===== PERFORMANCE : WEBP ET IMAGES RESPONSIVES ===== -->
<!-- widths et sizes permettent au navigateur de choisir une résolution adaptée ; lazy diffère le chargement. -->
<Image
  src={src}
  alt={alt}
  width={Math.min(width, src.width)}
  widths={[Math.min(width, src.width), Math.min(width * 2, src.width)]}
  sizes={`(max-width: 700px) calc(100vw - 40px), ${width}px`}
  format="webp"
  quality={88}
  loading={eager ? 'eager' : 'lazy'}
  class={className}
/>
