---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  eager?: boolean;
  class?: string;
}
const { src, alt, width = 1000, eager = false, class: className } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={Math.min(width, src.width)}
  widths={[Math.min(width, src.width), Math.min(width * 2, src.width)]}
  sizes={`(max-width: 700px) calc(100vw - 40px), ${width}px`}
  format="webp"
  quality={88}
  loading={eager ? 'eager' : 'lazy'}
  class={className}
/>
