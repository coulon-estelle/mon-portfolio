---
import Ornament from './Ornament.astro';
import FairyIllustration from './FairyIllustration.astro';
import { site } from '../data/site';
// Image à placer dans public/images/, puis renseigner son chemin ici.
const footerImage = '';
const socials = [
  { name: 'LinkedIn', url: site.linkedin },
  { name: site.creativeNetworkName, url: site.creativeNetwork },
].filter((profile) => profile.url);
---

<footer class="portfolio-footer">
  <div class="container footer-main">
    <nav class="footer-socials" aria-label="Retrouver mon travail">
      {socials.length ? (
        socials.map((profile) => (
          <a href={profile.url} target="_blank" rel="noopener noreferrer">
            {profile.name}
            <span class="sr-only"> (nouvel onglet)</span>
          </a>
        ))
      ) : (
        <a href="/projets">Mes projets</a>
      )}
    </nav>
    <div class="footer-image-slot">
      {footerImage ? (
        <img src={footerImage} alt="" width="220" height="220" loading="lazy" />
      ) : (
        <div class="footer-fairy illustration-scene">
          <span class="footer-moon">
            <Ornament kind="moon-pink" width={100} />
          </span>
          <span class="footer-drawn-star">
            <Ornament kind="star-blue" width={25} />
          </span>
          <FairyIllustration variant={1} width={180} />
        </div>
      )}
    </div>
    <nav class="footer-links" aria-label="Navigation de pied de page">
      <a href="/mentions-legales">Mentions légales & confidentialité</a>
      <a href="/a-propos">À propos</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>
  <div class="footer-copyright">
    <p>Copyright © {new Date().getFullYear()} Estelle COULON</p>
  </div>
</footer>
