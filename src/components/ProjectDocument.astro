---
interface Props {
  href: string;
  label?: string;
  size: string;
}
const { href, label = 'Voir le dossier complet', size } = Astro.props;
---

<div class="project-document">
  <a href={href} target="_blank" rel="noopener noreferrer">
    <span class="document-icon" aria-hidden="true">
      <svg viewBox="0 0 24 28" width="22" height="26" fill="none">
        <path
          d="M5 2h9l5 5v19H5zM14 2v6h5M8 14h8M8 18h8"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
      </svg>
    </span>
    <span>
      <span class="document-label">{label}</span>
      <span class="document-format">
        PDF · {size}
        <span class="sr-only"> · nouvel onglet</span>
      </span>
    </span>
    <span class="document-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</div>

<style>
  .project-document {
    margin-top: 24px;
    max-width: 390px;
  }
  .project-document a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 68px;
    padding: 15px 18px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: color-mix(in srgb, var(--pink) 6%, transparent);
    color: var(--ink);
  }
  .document-icon,
  .document-arrow {
    color: var(--pink);
    flex-shrink: 0;
  }
  .document-label,
  .document-format {
    display: block;
  }
  .document-label {
    font-size: 13px;
    line-height: 1.5;
  }
  .document-format {
    margin-top: 3px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.5;
  }
  .document-arrow {
    margin-left: auto;
    font-size: 21px;
  }
  .project-document a:hover {
    border-color: var(--pink);
    background: color-mix(in srgb, var(--pink) 11%, transparent);
  }
  .project-document a:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 5px;
  }
</style>
