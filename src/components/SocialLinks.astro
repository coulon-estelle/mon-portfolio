---
import { site } from '../data/site';
---

<nav class="social-cta" aria-label="Mes profils professionnels">
  <a href={site.creativeNetwork} target="_blank" rel="noopener noreferrer">
    <span class="social-icon" aria-hidden="true">
      Bē
    </span>
    <span>
      Mes créations sur {site.creativeNetworkName}
      <span class="sr-only"> (nouvel onglet)</span>
    </span>
    <span aria-hidden="true">↗</span>
  </a>
  <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
    <span class="social-icon" aria-hidden="true">
      in
    </span>
    <span>
      Mon profil LinkedIn<span class="sr-only"> (nouvel onglet)</span>
    </span>
    <span aria-hidden="true">↗</span>
  </a>
</nav>

<style>
  .social-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .social-cta a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 46px;
    padding: 11px 15px;
    border: 1px solid color-mix(in srgb, var(--pink) 45%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--pink) 7%, transparent);
    color: var(--ink);
    font-size: 12px;
    line-height: 1.5;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }
  .social-cta a:hover {
    border-color: var(--pink);
    background: color-mix(in srgb, var(--pink) 16%, transparent);
  }
  .social-icon {
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    color: var(--pink);
    font-size: 16px;
  }
  @media (max-width: 450px) {
    .social-cta a {
      width: 100%;
      justify-content: flex-start;
    }
    .social-cta a > span:last-child {
      margin-left: auto;
    }
  }
</style>
