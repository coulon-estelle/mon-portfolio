---
// ===== COMPOSANTS : PREPARATION ASTRO =====
// Les imports et les données de ce bloc sont traités par Astro, avant le HTML envoyé au navigateur.
import '../styles/global.css';
import '../styles/project-assets.css';
import '../styles/project-palettes.css';
import '../styles/desktop-typography.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import FairyEffects from '../components/FairyEffects.astro';
import { site } from '../data/site';
import { absoluteUrl, canonicalPath, structuredData } from '../data/seo';
import { getImage } from 'astro:assets';
import faviconStar from '../../public/images/illustrations/etoiles/etoile-rose.png';
// ===== IMAGES : FAVICON OPTIMISE =====
// Astro génère une petite image PNG à partir de l’étoile personnelle.
const favicon = await getImage({
  src: faviconStar,
  width: 48,
  height: 48,
  fit: 'contain',
  format: 'png',
});
// ===== COMPOSANTS : PROPRIETES TYPEES =====
// Décrit les paramètres que les pages peuvent transmettre au composant.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'Je suis Estelle Coulon, artiste passionnée de design et étudiante en BUT MMI. Découvrez mon univers à travers mes illustrations, mes identités visuelles et mes créations web.',
  noindex = false,
} = Astro.props;
// ===== SEO : URL CANONIQUE =====
// Construit l’adresse absolue de la page à partir du domaine et du chemin courant.
const canonical = noindex ? undefined : absoluteUrl(canonicalPath(Astro.url.pathname));
const jsonLd = noindex
  ? undefined
  : JSON.stringify(structuredData(Astro.url.pathname, title, description)).replace(/</g, '\\u003c');
// ===== SEO : IMAGE DE PARTAGE DU LIEN =====
// Les aperçus sociaux lisent une URL absolue vers le JPEG public, sans exécuter le JavaScript du site.
const socialImage = new URL('/images/illustrations/fees/fee-4.png', site.url).href;
const socialImageAlt =
  'Estelle Coulon — artiste et design : une fée dessinée par Estelle, une lune et des étoiles sur un fond bordeaux et violet.';
---

<!-- ===== STRUCTURE : GABARIT COMMUN ===== -->
<!-- Réunit les styles, métadonnées, en-tête, contenu de page et pied de page. -->

<!doctype html>
<html lang="fr">
  <head>
    <!-- ===== SEO : METADONNEES ET PARTAGE ===== -->
    <!-- Encodage, viewport, description, canonique et balises Open Graph communs aux pages. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/png" sizes="48x48" href={favicon.src} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Estelle Coulon — Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <!-- ===== SEO : IDENTITE ET FIL D ARIANE STRUCTURES ===== -->
    <!-- JSON-LD statique lisible sans JavaScript ; la page 404 en est exclue. -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <meta name="theme-color" content="#25070e" />
    <!-- ===== COULEURS : PREFERENCES AVANT AFFICHAGE ===== -->
    <!-- Lit le thème et le mouvement mémorisés avant le rendu du contenu. -->
    <script is:inline>
      // ===== INTERACTION : SCRIPT COTE NAVIGATEUR =====
      // Ce code agit sur le DOM après le chargement de la page.
      document.documentElement.dataset.js = 'true';
      try {
        const theme = localStorage.getItem('portfolio-theme');
        const motion = localStorage.getItem('portfolio-motion');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        if (motion === 'on' || motion === 'off') document.documentElement.dataset.motion = motion;
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Cursor />
    <FairyEffects />
    <!-- ===== ACCESSIBILITE : LIEN D EVITEMENT ===== -->
    <!-- Permet au clavier d’aller directement au contenu principal. -->
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <Header />
    <!-- ===== STRUCTURE : CONTENU DE LA PAGE ===== -->
    <!-- Astro insère ici le contenu fourni par chaque page utilisant Layout. -->
    <slot />
    <Footer />
  </body>
</html>
