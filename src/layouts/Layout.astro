---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import FairyEffects from '../components/FairyEffects.astro';
interface Props { title: string; description?: string; }
const { title, description = 'Estelle Coulon, étudiante en design graphique. Identité visuelle, UI/UX et web design : découvrez mon univers et mes projets.' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#25070e" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('portfolio-theme');
        const motion = localStorage.getItem('portfolio-motion');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
        if (motion === 'on' || motion === 'off') document.documentElement.dataset.motion = motion;
      } catch {}
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Cursor />
    <FairyEffects />
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
