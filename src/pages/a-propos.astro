---
import Ornament from '../components/Ornament.astro';
import PageOutro from '../components/PageOutro.astro';
import Layout from '../layouts/Layout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { projets } from '../data/projets';
// Placez le portrait et le CV dans public/, puis renseignez leurs chemins.
const portraitImage = '/images/commun/portrait.png';
const cvUrl = '';
const skills = [
  {
    name: 'Design',
    note: 'Identités et interfaces',
    items: [
      'Identité visuelle',
      'UI / UX design',
      'Maquettes & prototypes',
      'Communication visuelle',
      'Illustration',
    ],
  },
  {
    name: 'Web & audiovisuel',
    note: 'Intégration et montage',
    items: ['Astro', 'Tailwind CSS', 'WordPress', 'Montage vidéo', 'Intégration responsive'],
  },
  {
    name: 'Outils',
    note: 'Logiciels utilisés',
    items: ['Figma', 'Illustrator', 'Photoshop', 'DaVinci Resolve', 'VS Code'],
  },
];
---

<Layout
  title="À propos — Estelle Coulon"
  description="Découvrez le parcours d’Estelle Coulon, étudiante en deuxième année de BUT MMI à Montbéliard : de la mode au design graphique et à la création numérique."
>
  <main id="contenu" class="about-page">
    <section class="bio-heading container" aria-labelledby="bio-title">
      <a class="bio-breadcrumb" href="/">
        Accueil <span aria-hidden="true">/</span> À propos
      </a>
      <p class="eyebrow">À propos</p>
      <h1 id="bio-title">
        Je suis <span>Estelle Coulon.</span>
      </h1>
    </section>
    <section class="bio-story container" aria-label="Mon parcours">
      <div class="bio-copy">
        <p>
          Je suis étudiante en deuxième année de{' '}
          <strong>BUT Métiers du Multimédia et de l’Internet à Montbéliard.</strong>
        </p>
        <p>
          Mon parcours mêle mode, design et numérique. Avant le MMI, j’ai étudié les Métiers de la
          Mode et du Vêtement, une formation qui m’a permis de développer ma sensibilité artistique
          et mon goût pour la création.
        </p>
        <p>
          Aujourd’hui, j’explore l’identité visuelle, l’UI/UX, le web, la communication et
          l’audiovisuel. Mes projets portent sur la création d’identités visuelles, la conception
          d’interfaces et leur intégration web.
        </p>
        <div class="bio-opportunity">
          <span aria-hidden="true">✧</span>
          <p>
            Je recherche une <strong>alternance en création numérique ou en communication</strong>,
            pour continuer à apprendre et participer à des projets variés.
          </p>
        </div>
        <div class="bio-actions">
          <a class="button button-primary" href="/contact">
            Me contacter
          </a>
          {cvUrl ? (
            <a class="bio-cv" href={cvUrl} download>
              Télécharger mon CV
            </a>
          ) : (
            <span class="bio-cv-pending">Mon CV sera bientôt disponible</span>
          )}
        </div>
        <SocialLinks />
      </div>
      <div class="bio-portrait-wrap">
        <div class="bio-portrait">
          {portraitImage ? (
            <img
              src={portraitImage}
              alt="Portrait d’Estelle Coulon"
              width="470"
              height="597"
              fetchpriority="high"
            />
          ) : (
            <div class="bio-portrait-placeholder">
              <span class="bio-portrait-orbit" aria-hidden="true"></span>
              <span class="bio-monogram">Ec.</span>
              <span class="handwritten">Portrait</span>
              <span class="bio-photo-note">Mon portrait arrive bientôt</span>
            </div>
          )}
        </div>
        <span class="bio-portrait-star" aria-hidden="true">
          <Ornament kind="star-violet" width={56} />
        </span>
      </div>
    </section>
    <section class="bio-facts container" aria-label="Quelques repères">
      <div>
        <span>{projets.length} projets</span>
        <p>Études de cas</p>
      </div>
      <div>
        <span>Mode & MMI</span>
        <p>Mes formations</p>
      </div>
      <div>
        <span>C1</span>
        <p>Niveau d’anglais</p>
      </div>
    </section>
    <section class="bio-skills container" aria-labelledby="bio-skills-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Compétences et outils</p>
          <h2 id="bio-skills-title">
            Design, web <br />
            <span class="handwritten">et audiovisuel.</span>
          </h2>
        </div>
        <p>Les compétences mobilisées dans mes projets.</p>
      </div>
      <div class="bio-skills-grid">
        {skills.map((skill, index) => (
          <article class="bio-skill">
            <span class="bio-skill-number">0{index + 1}</span>
            <h3>{skill.name}</h3>
            <p>{skill.note}</p>
            <ul>
              {skill.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
    <PageOutro
      lead="Pour une alternance ou un projet"
      heading="Contactez-moi."
      href="/contact"
      label="Me contacter"
      secondaryHref="/projets"
      secondaryLabel="Explorer mes projets"
      variant={4}
    />
  </main>
</Layout>
<style>
  .about-page {
    overflow: clip;
    background: radial-gradient(ellipse 65% 35% at 100% 0%, #833db342, transparent 85%);
  }
  .bio-heading {
    padding-top: 145px;
    padding-bottom: 45px;
  }
  .bio-breadcrumb {
    display: inline-flex;
    gap: 12px;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 35px;
  }
  .bio-breadcrumb span {
    color: var(--purple);
  }
  .bio-heading .eyebrow {
    color: var(--blue);
  }
  .bio-heading h1 {
    font-family: var(--font-display);
    font-size: clamp(83px, 8vw, 120px);
    line-height: 0.9;
    font-weight: 400;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .bio-heading h1 > span {
    color: var(--pink);
  }
  .bio-story {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(55px, 8vw, 120px);
    align-items: center;
    padding-bottom: 75px;
  }
  .bio-copy > p {
    font-size: 14px;
    line-height: 1.85;
    color: var(--muted);
    margin-bottom: 22px;
  }
  .bio-copy strong {
    color: var(--purple);
    font-weight: 500;
  }
  .bio-copy .bio-opening {
    font:
      500 22px/1.3 'Space Grotesk',
      sans-serif;
    color: var(--ink);
    margin-bottom: 28px;
  }
  .bio-opening .handwritten {
    font-size: 37px;
    color: var(--blue);
    font-weight: 400;
  }
  .bio-opportunity {
    display: flex;
    align-items: start;
    gap: 16px;
    padding: 20px 0 20px 20px;
    border-left: 1px solid #eba7bf70;
    margin: 30px 0;
    background: linear-gradient(90deg, #eba7bf08, transparent);
  }
  .bio-opportunity > span {
    font-size: 25px;
    color: var(--pink);
  }
  .bio-opportunity p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0;
  }
  .bio-opportunity strong {
    color: var(--pink);
  }
  .bio-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }
  .bio-cv {
    font-size: 12px;
    color: var(--blue);
    border-bottom: 1px solid currentColor;
    padding-block: 8px;
  }
  .bio-cv-pending {
    font-size: 10px;
    color: var(--muted);
  }
  .bio-portrait-wrap {
    position: relative;
    max-width: 480px;
    width: 100%;
    justify-self: end;
  }
  .bio-portrait {
    aspect-ratio: 4/5;
    overflow: hidden;
    border: 1px solid #b997ed66;
    border-radius: 140px 140px 16px 16px;
    background:
      radial-gradient(ellipse at 80% 20%, #8bcbed20, transparent 60%),
      linear-gradient(150deg, #6c376347, #39204a55);
    box-shadow: 0 0 70px #a860c910;
  }
  .bio-portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    display: block;
  }
  .bio-portrait-placeholder {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .bio-portrait-orbit {
    position: absolute;
    inset: 17% 12%;
    border: 1px solid #b997ed40;
    border-radius: 50%;
    transform: rotate(-25deg);
  }
  .bio-monogram {
    font-family: var(--font-display);
    font-size: 145px;
    color: var(--purple);
    line-height: 1;
    transform: rotate(-10deg);
    text-shadow: 4px 5px 0 #eba7bf22;
  }
  .bio-portrait-placeholder > .handwritten {
    font-size: 42px;
    line-height: 0.9;
    color: var(--pink);
    text-align: center;
    position: relative;
  }
  .bio-photo-note {
    font-size: 9px;
    color: var(--muted);
    margin-top: 35px;
    letter-spacing: 0.08em;
  }
  .bio-portrait-star {
    position: absolute;
    width: 56px;
    right: -23px;
    top: 12%;
    font-size: 65px;
    color: var(--blue);
    animation: fairy-float 8s ease-in-out infinite;
  }
  .bio-portrait-caption {
    font-family: var(--font-display);
    font-size: 25px;
    text-align: center;
    color: var(--pink);
    margin: 17px 0 0;
    transform: rotate(-3deg);
  }
  .bio-facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    padding-block: 35px;
    border-block: 1px solid var(--line);
  }
  .bio-facts > div {
    text-align: center;
  }
  .bio-facts > div + div {
    border-left: 1px solid var(--line);
  }
  .bio-facts span {
    font-family: var(--font-display);
    font-size: 37px;
    line-height: 1;
    color: var(--purple);
  }
  .bio-facts > div:nth-child(even) span {
    color: var(--blue);
  }
  .bio-facts p {
    font-size: 10px;
    color: var(--muted);
    line-height: 1.6;
    margin: 12px 0 0;
  }
  .bio-skills {
    padding-block: 85px;
  }
  .bio-skills .eyebrow {
    color: var(--blue);
  }
  .bio-skills h2 .handwritten {
    color: var(--pink);
  }
  .bio-skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .bio-skill {
    --skill-color: var(--pink);
    border-top: 1px solid var(--skill-color);
    padding-top: 22px;
  }
  .bio-skill:nth-child(2) {
    --skill-color: var(--blue);
  }
  .bio-skill:nth-child(3) {
    --skill-color: var(--purple);
  }
  .bio-skill-number {
    font-size: 10px;
    color: var(--skill-color);
    letter-spacing: 0.12em;
  }
  .bio-skill h3 {
    font-size: 22px;
    letter-spacing: -0.035em;
    color: var(--skill-color);
    font-weight: 500;
    margin: 18px 0 10px;
  }
  .bio-skill > p {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 23px;
  }
  .bio-skill ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .bio-skill li {
    font-size: 13px;
    color: var(--ink);
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }
  .bio-manifesto {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 60px;
    min-height: 225px;
    padding: 40px 25px;
    border-block: 1px solid #b997ed44;
    background: linear-gradient(115deg, #82255088, #6d368077 45%, #54233888);
  }
  .bio-manifesto::before {
    content: '';
    position: absolute;
    inset: -100%;
    z-index: -1;
    background: linear-gradient(
      115deg,
      transparent 35%,
      #8bcbed30 46%,
      #b997ed44 50%,
      transparent 63%
    );
    animation: bio-light 16s ease-in-out infinite alternate;
  }
  .bio-manifesto p {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 85px);
    line-height: 1;
    margin: 0;
    color: var(--ink);
  }
  .bio-manifesto em {
    font-style: normal;
    color: var(--pink);
  }
  .bio-manifesto > span {
    font-size: 35px;
    color: var(--blue);
  }
  :global(html[data-theme='light']) .about-page {
    background: radial-gradient(ellipse 65% 35% at 100% 0%, #d6c4eb55, transparent 85%);
  }
  :global(html[data-theme='light']) .bio-portrait {
    background:
      radial-gradient(ellipse at 80% 20%, #d1eaf2, transparent 65%),
      linear-gradient(150deg, #ead8ed, #f9e9ee);
  }
  :global(html[data-theme='light']) .bio-manifesto {
    background: linear-gradient(115deg, #f1d4e1, #e3d5ef 50%, #dfecf3);
  }
  @keyframes bio-light {
    from {
      transform: translateX(-12%) rotate(-5deg);
    }
    to {
      transform: translateX(12%) rotate(5deg);
    }
  }
  @media (max-width: 1000px) {
    .bio-story {
      gap: 40px;
    }
    .bio-portrait {
      border-radius: 110px 110px 14px 14px;
    }
    .bio-skills-grid {
      gap: 25px;
    }
    .bio-facts {
      gap: 15px;
    }
  }
  @media (max-width: 700px) {
    .bio-heading {
      padding-top: 105px;
      padding-bottom: 30px;
    }
    .bio-breadcrumb {
      margin-bottom: 28px;
    }
    .bio-heading .eyebrow {
      font-size: 8px;
      letter-spacing: 0.13em;
    }
    .bio-heading h1 {
      font-size: clamp(64px, 18vw, 96px);
      line-height: 0.94;
    }
    .bio-story {
      display: flex;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 35px;
      padding-bottom: 45px;
    }
    .bio-portrait-wrap {
      max-width: 290px;
      align-self: center;
      width: 85%;
    }
    .bio-portrait {
      aspect-ratio: 1.1;
      border-radius: 100px 100px 14px 14px;
    }
    .bio-monogram {
      font-size: 95px;
    }
    .bio-portrait-placeholder > .handwritten {
      font-size: 29px;
    }
    .bio-photo-note {
      font-size: 8px;
      margin-top: 20px;
    }
    .bio-portrait-star {
      width: 35px;
      font-size: 40px;
      right: -14px;
    }
    .bio-portrait-caption {
      font-size: 21px;
      margin-top: 13px;
    }
    .bio-copy > p {
      font-size: 13px;
      line-height: 1.85;
    }
    .bio-copy .bio-opening {
      font-size: 20px;
    }
    .bio-opening .handwritten {
      font-size: 32px;
    }
    .bio-opportunity {
      margin-block: 24px;
      padding: 16px 0 16px 15px;
      gap: 10px;
    }
    .bio-actions {
      gap: 15px;
    }
    .bio-facts {
      grid-template-columns: 1fr 1fr;
      gap: 27px 20px;
      padding-block: 28px;
    }
    .bio-facts > div + div {
      border: 0;
    }
    .bio-facts span {
      font-size: 32px;
    }
    .bio-facts p {
      font-size: 9px;
      margin-top: 8px;
    }
    .bio-skills {
      padding-block: 50px;
    }
    .bio-skills .section-heading {
      margin-bottom: 32px;
    }
    .bio-skills h2 {
      font-size: 33px;
    }
    .bio-skills-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .bio-skill {
      padding-top: 18px;
    }
    .bio-skill h3 {
      margin-top: 12px;
    }
    .bio-skill > p {
      margin-bottom: 17px;
    }
    .bio-skill ul {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 18px;
    }
    .bio-skill li {
      font-size: 12px;
      line-height: 1.6;
      padding: 11px 0;
    }
    .bio-manifesto {
      min-height: 170px;
      gap: 15px;
      padding: 35px 20px;
    }
    .bio-manifesto p {
      font-size: clamp(37px, 10vw, 60px);
      text-align: center;
    }
    .bio-manifesto > span {
      font-size: 22px;
    }
  }
</style>
