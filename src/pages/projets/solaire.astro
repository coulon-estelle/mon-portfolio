---
import Layout from '../../layouts/Layout.astro';
import PageOutro from '../../components/PageOutro.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import { projectAssets } from '../../data/project-assets';

const assets = projectAssets.solaire;
const figmaUrl =
  'https://www.figma.com/proto/ooHa9AIAa8cOl0zQOnbYVJ/Solaire?node-id=19-3&p=f&t=baMcFT1NzimR42Lx-1&scaling=scale-down&content-scaling=fixed&page-id=19%3A2&starting-point-node-id=19%3A3';
---

<Layout
  title="Solaire — Identité visuelle & prototype UX/UI | Estelle Coulon"
  description="Solaire : conception d’un configurateur de lunettes en BUT MMI, de la journée type illustrée de Bernard à l’identité visuelle et au prototype interactif Figma."
>
  <main id="contenu" class="solaire-case">
    <section class="case-hero container" aria-labelledby="solaire-title">
      <a class="case-back" href="/projets">
        Tous les projets <span aria-hidden="true">/</span> Solaire
      </a>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Identité visuelle · UX/UI</p>
          <h1 id="solaire-title" class="case-brand-logo">
            <img src={assets.logo} alt="Solaire" width="776" height="227" fetchpriority="high" />
          </h1>
          <p class="case-tagline">
            Configurateur de lunettes
            <br />
            <span class="handwritten">Prototype UX/UI.</span>
          </p>
          <div class="case-tags">
            <span>Projet pédagogique · BUT MMI</span>
            <span>UX / UI</span>
            <span>Figma & Illustrator</span>
          </div>
          <a class="case-button" href={figmaUrl} target="_blank" rel="noopener noreferrer">
            Explorer le prototype Figma <span class="sr-only">(nouvel onglet)</span>
            <span aria-hidden="true">↗</span>
          </a>
          <p class="hero-summary">
            Un projet de BUT MMI : imaginer une identité et un parcours de personnalisation de
            lunettes à partir d’un persona imposé.
          </p>
        </div>
        <figure class="hero-preview">
          <img class="hero-flower" src={assets.icon} alt="" width="190" height="190" />
          <a
            href={figmaUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Explorer le prototype Solaire sur Figma (nouvel onglet)"
          >
            <ProjectImage
              src={assets.mockup}
              alt="Prototype Solaire présenté sur un ordinateur : lunettes sur la plage et interface rose et jaune"
              width={1000}
              eager
            />
            <span class="preview-caption">
              Voir le prototype <span aria-hidden="true">↗</span>
            </span>
          </a>
        </figure>
      </div>
    </section>

    <section class="case-journey container" aria-labelledby="solaire-journey">
      <div>
        <p class="eyebrow">01 — Recherche UX</p>
        <h2 id="solaire-journey">
          Une journée <span class="handwritten">avec Bernard.</span>
        </h2>
        <p>
          J’ai commencé par illustrer la journée type de Bernard, 60 ans, célibataire et retraité,
          en vacances à la plage. Cette BD sert de point de départ à la réflexion sur ses usages.
        </p>
        <a
          class="text-link"
          href="/images/projets/solaire/journee-type-solaire.png"
          target="_blank"
          rel="noopener noreferrer"
        >
          Voir la journée type en grand <span class="sr-only">(nouvel onglet)</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <figure class="journey-image">
        <a
          href="/images/projets/solaire/journee-type-solaire.png"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Agrandir la journée type de Bernard (nouvel onglet)"
        >
          <ProjectImage
            src={assets.journey}
            alt="BD Épicurien en vacances : la journée de Bernard, du café à 7 h à la soirée dans un bar à 20 h, en passant par la plage et la sieste"
            width={700}
          />
        </a>
        <figcaption>Ma journée type illustrée : « Épicurien en vacances ».</figcaption>
      </figure>
    </section>

    <section class="case-identity case-columns container" aria-labelledby="solaire-identity">
      <div>
        <p class="eyebrow">02 — Identité visuelle</p>
        <h2 id="solaire-identity">
          L’identité <span class="handwritten">visuelle.</span>
        </h2>
        <p>
          Un logo à fleur d’hibiscus et une palette rose, violette, orange et jaune. Le brandboard
          réunit les couleurs, les typographies et les déclinaisons du logo.
        </p>
        <div class="logo-research">
          {assets.research.map((src, index) => (
            <figure>
              <img
                src={src}
                alt={`Recherche graphique pour le logo Solaire, piste ${index + 1}`}
                loading="lazy"
                width="320"
                height="180"
              />
              <figcaption>Recherche de logo — piste {index + 1}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <figure class="brandboard">
        <ProjectImage
          src={assets.brandboard}
          alt="Brandboard Solaire : logo à fleur d’hibiscus, palette rose, violet, orange et jaune, et typographies Krona One, Noticia Text et Amaranth"
          width={650}
        />
        <figcaption>Le brandboard et les fondations de l’identité Solaire.</figcaption>
      </figure>
    </section>

    <PageOutro
      lead="Autres études de cas"
      heading="Découvrez les autres projets."
      href="/projets"
      label="Retour à la galerie"
      variant={2}
    />
  </main>
</Layout>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(30px, 5vw, 70px);
  }
  .hero-copy {
    min-width: 0;
  }
  .hero-summary {
    max-width: 430px;
    margin: 25px 0 0;
  }
  .hero-preview {
    position: relative;
    padding-block: 60px 30px;
    isolation: isolate;
  }
  .hero-preview::before {
    content: '';
    position: absolute;
    inset: 5% -5% 0;
    z-index: -1;
    border-radius: 48% 48% 24px 24px;
    background: linear-gradient(145deg, #f7d2f9, #ff9d00);
    opacity: 0.22;
    border: 1px solid #ff69eb55;
  }
  .hero-preview a {
    display: block;
    position: relative;
  }
  .hero-preview :global(img:not(.hero-flower)) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 25px #0004);
  }
  .hero-flower {
    position: absolute;
    right: -15px;
    top: -35px;
    width: 145px;
    height: 145px;
    object-fit: contain;
    rotate: 12deg;
    z-index: -1;
  }
  .preview-caption {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-top: 20px;
    color: var(--ink);
    font-size: 13px;
  }
  .hero-preview a:hover .preview-caption {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .case-summary {
    padding-block: 0 20px;
  }
  .case-summary p {
    max-width: 720px;
  }
  .solaire-case {
    overflow: clip;
    background: radial-gradient(ellipse 65% 25% at 100% 0%, #ff9d001a, transparent 85%);
  }
  .case-hero {
    padding-block: 145px 55px;
  }
  .case-back {
    display: inline-flex;
    gap: 14px;
    color: var(--muted);
    font-size: 11px;
    margin-bottom: 45px;
  }
  .eyebrow {
    color: var(--pink);
    font-size: 10px;
  }
  .case-brand-logo {
    width: min(390px, 100%);
    padding: 20px;
    border-radius: 12px;
    background: #f7d2f9;
    margin: 24px 0;
  }
  .case-brand-logo img {
    display: block;
    width: 100%;
    height: auto;
  }
  .case-tagline {
    font-size: 21px;
    line-height: 1.4;
  }
  .case-tagline .handwritten {
    font-size: 45px;
  }
  .handwritten {
    color: var(--pink);
  }
  .case-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-block: 24px 30px;
  }
  .case-tags span {
    padding: 9px 14px;
    border: 1px solid var(--line);
    border-radius: 24px;
    color: var(--muted);
    font-size: 11px;
  }
  .case-button {
    display: inline-flex;
    gap: 20px;
    align-items: center;
    padding: 15px 22px;
    border: 1px solid var(--pink);
    border-radius: 30px;
    background: var(--pink);
    color: var(--bg);
    font-size: 12px;
  }
  .case-button:hover,
  .text-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .case-columns,
  .case-journey {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(35px, 7vw, 100px);
    padding-block: 35px 55px;
  }
  .case-journey {
    align-items: center;
  }
  h2 {
    font-size: clamp(30px, 3.5vw, 42px);
    line-height: 1.2;
    margin: 16px 0 26px;
  }
  p:not(.eyebrow):not(.case-tagline) {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    color: var(--pink);
    font-size: 12px;
    margin-top: 15px;
    padding-block: 10px;
    border-bottom: 1px solid var(--line);
  }
  figure {
    margin: 0;
    min-width: 0;
  }
  .journey-image :global(img),
  .brandboard :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  figcaption {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
    margin-top: 16px;
  }
  .case-process,
  .case-previews {
    padding-block: 25px 55px;
  }
  .case-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 30px 0 0;
  }
  .case-steps li {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .step-number {
    font-size: 11px;
    color: var(--pink);
    letter-spacing: 0.14em;
  }
  .case-steps h3 {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.1;
    margin: 18px 0;
  }
  .logo-research {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: 30px;
  }
  .logo-research img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: contain;
    padding: 15px;
    border-radius: 12px;
    background: #fff;
  }
  .brandboard {
    max-width: 480px;
    justify-self: center;
  }
  .case-previews > p:not(.eyebrow) {
    max-width: 750px;
  }
  .case-previews figure {
    margin-top: 30px;
  }
  .case-previews :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 700px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .hero-preview {
      width: 100%;
      max-width: 550px;
      margin-inline: auto;
      padding-top: 45px;
    }
    .hero-flower {
      width: 110px;
      height: 110px;
      top: -10px;
      right: 0;
    }
    .case-hero {
      padding-block: 110px 30px;
    }
    .case-back {
      margin-bottom: 28px;
    }
    .case-columns,
    .case-journey,
    .case-steps {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .case-columns,
    .case-journey,
    .case-process,
    .case-previews {
      padding-block: 25px;
    }
    .journey-image {
      max-width: 480px;
      margin-inline: auto;
    }
  }
</style>
