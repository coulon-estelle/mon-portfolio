---
import MockupLabel from '../../components/MockupLabel.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import { projectAssets } from '../../data/project-assets';
import Ornament from '../../components/Ornament.astro';
import PageOutro from '../../components/PageOutro.astro';
import Layout from '../../layouts/Layout.astro';
// Ajoutez les captures dans public/images/ puis renseignez leurs chemins ici.
const mobileImage = projectAssets.lumimix.mobile;
const websiteUrl = 'https://lumimix.estelle-coulon.fr/';
const steps = [
  {
    title: 'Analyse & adaptation',
    text: "J'ai commencé par étudier la maquette mobile existante afin de comprendre sa structure et ses choix graphiques. J'ai ensuite réalisé sa version desktop en réorganisant les contenus, les espacements et les différents éléments pour les adapter aux écrans plus larges, tout en conservant l'identité du festival.",
  },
  {
    title: 'Développement',
    text: "J'ai développé le site avec Astro et Tailwind CSS pour construire des pages responsives et réutilisables. J'ai intégré les différentes sections du festival, notamment la présentation des artistes, des scènes et de la programmation, en veillant à respecter les maquettes.",
  },
  {
    title: 'Intégration & mise en ligne',
    text: "J'ai utilisé PocketBase pour gérer les contenus du site à travers plusieurs collections : artistes, scènes, programmation, équipes et groupes. Ces données ont ensuite été reliées aux pages pour permettre leur affichage dynamique. Le projet a finalement été déployé sur un serveur web afin de le rendre accessible en ligne.",
  },
];
---

<Layout
  title="LUMIMIX — Développement web & festival électro | Estelle Coulon"
  description="Étude de cas LUMIMIX : développement d’un site de festival électro avec Astro, Tailwind CSS et PocketBase, adaptation desktop et contenus dynamiques."
>
  <main id="contenu" class="lumimix-case">
    <section class="case-hero container" aria-labelledby="lumimix-title">
      <a class="case-back" href="/projets">
        Tous les projets <span aria-hidden="true">/</span> LUMIMIX
      </a>
      <div class="case-intro">
        <div>
          <p class="eyebrow">Développement web — Festival électro — 2026</p>
          <h1 id="lumimix-title" class="case-brand-logo">
            <ProjectImage src={projectAssets.lumimix.logo} alt="LUMIMIX" width={480} eager />
          </h1>
          <p class="case-tagline">
            À la rencontre de la lumière <br />
            <span class="handwritten">et du son.</span>
          </p>
          <div class="case-tags">
            <span>Astro</span>
            <span>Tailwind CSS</span>
            <span>PocketBase</span>
            <span>SAÉ 203 · BUT MMI</span>
          </div>
        </div>
        <div class="galaxy-art" aria-hidden="true">
          <span class="galaxy-star">
            <Ornament kind="star-violet" width={48} />
          </span>
          <span class="galaxy-small-star">
            <Ornament kind="star-blue" width={32} />
          </span>
        </div>
      </div>
    </section>
    <section class="case-context case-two-columns container" aria-label="Présentation du projet">
      <div>
        <p class="eyebrow">Le point de départ</p>
        <h2>
          Contexte <span class="handwritten">& commande.</span>
        </h2>
        <p>
          LUMIMIX est un projet collectif réalisé dans le cadre de la SAÉ 203 de mon BUT MMI.
          L'objectif était de concevoir un site web pour un festival de musique électro, permettant
          aux visiteurs de découvrir les artistes, les scènes et la programmation de l'événement.
        </p>
        <p>
          Le projet associait conception graphique, développement web et gestion de contenus
          dynamiques afin de créer une expérience immersive et adaptée à l'univers du festival.
        </p>
      </div>
      <div>
        <p class="eyebrow">Ma contribution</p>
        <h2>
          Mon rôle <span class="handwritten">exact.</span>
        </h2>
        <p>
          Je me suis principalement occupée du développement du site web avec Astro, Tailwind CSS et
          PocketBase.
        </p>
        <p>
          L'identité visuelle et la maquette mobile initiale avaient été réalisées par d'autres
          membres du groupe. À partir de cette base, j'ai conçu la déclinaison desktop de la
          maquette, puis développé les différentes pages du site en respectant la direction
          artistique définie.
        </p>
        <p>
          J'ai également travaillé sur l'intégration des données dynamiques et leur affichage sur le
          site.
        </p>
      </div>
    </section>
    <section class="case-process container" aria-labelledby="lumimix-process">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Processus — Recherches, pistes, arbitrages</p>
          <h2 id="lumimix-process">
            De la maquette <span class="handwritten">à l’expérience.</span>
          </h2>
        </div>
      </div>
      <ol class="case-steps">
        {steps.map((step, index) => (
          <li>
            <span class="step-number">0{index + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>
    <section
      class="case-design case-two-columns container"
      aria-label="Choix techniques et résultat"
    >
      <div>
        <p class="eyebrow">Choix techniques & graphiques</p>
        <h2>
          Respecter l’univers, <br />
          <span class="handwritten">construire l’expérience.</span>
        </h2>
        <p>
          Pour le développement, j'ai choisi Astro pour sa structure en composants et Tailwind CSS
          pour faciliter la mise en page responsive.
        </p>
        <p>
          PocketBase m'a permis de centraliser les informations du festival et de les exploiter
          dynamiquement sur le site.
        </p>
        <p>
          Sur le plan graphique, mon travail a consisté à respecter l'identité visuelle créée par le
          groupe, tout en adaptant la maquette mobile à une version desktop cohérente, lisible et
          fonctionnelle.
        </p>
        <div class="tech-stack">
          <span>Composants Astro</span>
          <span>Responsive</span>
          <span>Contenus dynamiques</span>
        </div>
      </div>
      <div>
        <p class="eyebrow">Résultat</p>
        <h2>
          Un festival <span class="handwritten">prend vie.</span>
        </h2>
        <p>
          Le projet a abouti à un site web responsive dédié au festival LUMIMIX, présentant les
          artistes, les scènes et leur programmation grâce à des contenus issus de PocketBase.
        </p>
        <p>
          Ce projet m'a permis de renforcer mes compétences en développement front-end, en
          intégration de maquettes et en gestion de données dynamiques. Il m'a également appris à
          adapter une direction artistique existante à différents formats d'écran.
        </p>
      </div>
    </section>
    <section class="case-previews container" aria-labelledby="lumimix-previews">
      <p class="eyebrow">Un univers, plusieurs écrans</p>
      <h2 id="lumimix-previews">
        Immersif, <span class="handwritten">à chaque format.</span>
      </h2>
      <div class="lumimix-preview-grid">
        <figure class="mobile-preview">
          <a
            class="preview-site-link project-preview-link"
            href={websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Découvrir le site LUMIMIX — aperçu mobile (nouvel onglet)"
          >
            <MockupLabel text="Découvrir le site LUMIMIX" />
            {mobileImage ? (
              <ProjectImage src={mobileImage} alt="Version mobile du site LUMIMIX" width={650} />
            ) : (
              <div class="mobile-mockup">
                <span class="phone-camera"></span>
                <span class="mockup-wordmark">LUMIMIX</span>
                <span class="mockup-orbit" aria-hidden="true"></span>
                <span class="mockup-note">Capture mobile à venir</span>
              </div>
            )}
          </a>
        </figure>
      </div>
    </section>
    <PageOutro
      lead="Autres études de cas"
      heading="Découvrez les autres projets."
      href="/projets"
      label="Retour à la galerie"
      variant={3}
    />
  </main>
</Layout>
<style>
  .preview-site-link {
    display: block;
    border-radius: 12px;
  }
  .preview-site-link:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 8px;
  }

  .lumimix-case {
    --galaxy-blue: #32d9ef;
    --galaxy-purple: #bd94ef;
    overflow: clip;
    background:
      radial-gradient(ellipse 65% 26% at 100% 0%, #6535a35c, transparent 85%),
      radial-gradient(ellipse 45% 23% at 0 30%, #337baf20, transparent 80%);
  }
  .case-hero {
    padding-top: 140px;
    padding-bottom: 55px;
  }
  .case-back {
    display: inline-flex;
    gap: 14px;
    font-size: 10px;
    color: var(--muted);
    margin-bottom: 45px;
  }
  .case-back span {
    color: var(--purple);
  }
  .case-intro {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: center;
    gap: 30px;
  }
  .case-intro .eyebrow {
    color: var(--blue);
    font-size: 10px;
  }
  .case-intro h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(60px, 8vw, 116px);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 1.05;
    color: var(--ink);
    text-shadow: 0 0 35px #e429e940;
    margin-bottom: 24px;
  }
  .case-tagline {
    font-size: 18px;
    line-height: 1.4;
  }
  .case-tagline .handwritten {
    font-size: 43px;
    color: var(--purple);
  }
  .case-tags,
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .case-tags span,
  .tech-stack span {
    font-size: 9px;
    border: 1px solid #32d9ef40;
    border-radius: 25px;
    padding: 9px 13px;
    color: var(--blue);
  }
  .galaxy-art {
    position: relative;
    height: 280px;
    isolation: isolate;
  }
  .galaxy-art::before {
    content: '';
    position: absolute;
    inset: 8%;
    background: radial-gradient(ellipse, #a047b952, #4677ba22 40%, transparent 70%);
    filter: blur(25px);
  }
  .galaxy-planet {
    position: absolute;
    inset: 23% 28%;
    border-radius: 50%;
    background: radial-gradient(circle at 25% 20%, #bdeeff, #7f62c4 38%, #692f83 65%, #1d1437);
    box-shadow:
      inset -12px -15px 25px #11052288,
      0 0 40px #e429e930;
  }
  .galaxy-orbit {
    position: absolute;
    inset: 28% 3%;
    border: 1px solid #32d9efaa;
    border-radius: 50%;
    transform: rotate(-30deg);
    box-shadow: 0 0 16px #32d9ef22;
    z-index: 1;
  }
  .orbit-two {
    inset: 16% 17%;
    transform: rotate(38deg);
    border-color: #f42aa470;
  }
  .galaxy-star {
    position: absolute;
    right: 8%;
    top: 6%;
    font-size: 47px;
    color: var(--blue);
    animation: fairy-float 7s ease-in-out infinite;
  }
  .galaxy-small-star {
    position: absolute;
    left: 9%;
    bottom: 10%;
    font-size: 25px;
    color: var(--pink);
    animation: fairy-twinkle 6s ease-in-out infinite;
  }
  .case-two-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 7vw, 100px);
  }
  .case-context {
    padding-block: 40px 65px;
  }
  .case-two-columns .eyebrow {
    font-size: 9px;
    color: var(--purple);
    margin-bottom: 18px;
  }
  .case-two-columns h2 {
    font-size: 30px;
    line-height: 1.15;
    margin-bottom: 25px;
  }
  .case-two-columns h2 .handwritten {
    font-size: 1.3em;
    color: var(--blue);
  }
  .case-two-columns p:not(.eyebrow) {
    font-size: 13px;
    line-height: 1.85;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .case-process {
    padding-block: 30px 75px;
  }
  .case-process .eyebrow {
    color: var(--pink);
    font-size: 9px;
  }
  .case-process h2 {
    font-size: 39px;
  }
  .case-process h2 .handwritten {
    color: var(--purple);
  }
  .case-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .case-steps li {
    position: relative;
    padding: 26px 23px;
    border: 1px solid #e429e970;
    border-radius: 12px;
    background: linear-gradient(140deg, #8c57bc14, #32d9ef05);
    transition:
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .case-steps li + li::before {
    content: '';
    position: absolute;
    top: 46px;
    left: -31px;
    width: 30px;
    height: 1px;
    background: linear-gradient(90deg, #e429e977, #32d9ef77);
  }
  .step-number {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--blue);
  }
  .case-steps h3 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    line-height: 1.05;
    color: var(--purple);
    margin: 16px 0;
  }
  .case-steps li:nth-child(2) h3 {
    color: var(--blue);
  }
  .case-steps li:nth-child(3) h3 {
    color: var(--pink);
  }
  .case-steps p {
    font-size: 12px;
    line-height: 1.85;
    color: var(--muted);
    margin: 0;
  }
  .case-steps li:hover {
    border-color: var(--blue);
    box-shadow: 0 0 30px #32d9ef0d;
  }
  .case-design {
    padding-block: 20px 60px;
  }
  .case-design .eyebrow {
    color: var(--blue);
  }
  .case-design .button {
    margin-top: 10px;
  }
  .case-previews {
    padding-block: 30px 45px;
  }
  .case-previews > .eyebrow {
    color: var(--blue);
    font-size: 9px;
  }
  .case-previews > h2 {
    font-size: 39px;
    margin-bottom: 45px;
  }
  .case-previews > h2 .handwritten {
    color: var(--purple);
  }
  .lumimix-preview-grid {
    max-width: 650px;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr);
    display: grid;

    align-items: center;
    gap: 55px;
  }
  .lumimix-preview-grid figure {
    margin: 0;
    min-width: 0;
  }
  .lumimix-preview-grid img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    display: block;
  }
  .lumimix-preview-grid figcaption {
    font-size: 10px;
    color: var(--muted);
    margin-top: 20px;
    text-align: center;
  }
  .browser-mockup {
    border: 1px solid #e429e977;
    border-radius: 12px;
    overflow: hidden;
    background: #11101e;
    box-shadow: 0 20px 50px #07041055;
  }
  .browser-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 33px;
    padding: 10px 13px;
    background: #211d33;
  }
  .browser-bar i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e429e9;
  }
  .browser-bar i:nth-child(2) {
    background: #f42aa4;
  }
  .browser-bar i:nth-child(3) {
    background: #32d9ef;
  }
  .browser-bar span {
    margin-left: 14px;
    font-size: 8px;
    color: #b9a9c7;
  }
  .browser-screen {
    position: relative;
    aspect-ratio: 1.65;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(ellipse at 65% 50%, #78278c88, transparent 70%), #0d111f;
  }
  .mockup-wordmark {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(25px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.07em;
    color: #f8edf9;
    position: relative;
    z-index: 1;
  }
  .mockup-orbit {
    position: absolute;
    width: 65%;
    height: 48%;
    border: 1px solid #32d9efaa;
    border-radius: 50%;
    transform: rotate(-35deg);
    box-shadow:
      0 0 20px #b64ba944,
      0 0 0 12px #a647b315,
      0 0 0 25px #a647b310;
  }
  .mockup-note {
    position: absolute;
    bottom: 20px;
    font-size: 9px;
    color: #c9b6d8;
  }
  .mobile-mockup {
    position: relative;
    aspect-ratio: 1/1.9;
    max-width: 230px;
    margin-inline: auto;
    border: 4px solid #736784;
    border-radius: 30px;
    background: radial-gradient(ellipse at 70% 45%, #682f87, transparent 65%), #0d111f;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 10px 18px 35px #07041044;
  }
  .mobile-mockup .mockup-wordmark {
    font-size: 30px;
  }
  .mobile-mockup .mockup-orbit {
    height: 24%;
    width: 85%;
  }
  .phone-camera {
    position: absolute;
    top: 10px;
    width: 45px;
    height: 9px;
    background: #090811;
    border-radius: 15px;
  }
  .website-address {
    text-align: center;
    margin: 35px 0 0;
    font-size: 12px;
    color: var(--blue);
  }
  .website-address a {
    padding-block: 8px;
    border-bottom: 1px solid #32d9ef55;
  }
  :global(html[data-theme='light']) .lumimix-case {
    background:
      radial-gradient(ellipse 65% 26% at 100% 0%, #c7b4ee66, transparent 85%),
      radial-gradient(ellipse 45% 23% at 0 30%, #b9ddef33, transparent 80%);
  }
  :global(html[data-theme='light']) .case-steps li {
    background: linear-gradient(140deg, #eee3fa88, #f1faff66);
  }
  @media (max-width: 700px) {
    .case-hero {
      padding-top: 105px;
      padding-bottom: 20px;
    }
    .case-back {
      margin-bottom: 30px;
    }
    .case-intro {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .case-intro .eyebrow {
      font-size: 8px;
      letter-spacing: 0.08em;
      line-height: 1.8;
    }
    .case-intro h1 {
      font-size: clamp(55px, 15vw, 89px);
    }
    .case-tagline {
      font-size: 17px;
    }
    .case-tagline .handwritten {
      font-size: 36px;
    }
    .galaxy-art {
      height: 190px;
      max-width: 280px;
      width: 100%;
      justify-self: end;
    }
    .galaxy-star {
      font-size: 30px;
    }
    .case-two-columns {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .case-context {
      padding-block: 15px 35px;
    }
    .case-two-columns h2 {
      font-size: 28px;
      margin-bottom: 20px;
    }
    .case-process {
      padding-block: 20px 40px;
    }
    .case-process h2,
    .case-previews > h2 {
      font-size: 31px;
    }
    .case-steps {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .case-steps li {
      padding: 23px;
    }
    .case-steps li + li::before {
      top: -23px;
      left: 35px;
      width: 1px;
      height: 22px;
    }
    .case-design {
      padding-block: 10px 30px;
    }
    .case-previews {
      padding-block: 20px 30px;
    }
    .lumimix-preview-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 35px;
    }
    .mobile-mockup {
      width: 195px;
    }
    .mockup-wordmark {
      font-size: 36px;
    }
    .lumimix-preview-grid figcaption {
      font-size: 9px;
    }
  }
</style>
