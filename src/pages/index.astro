---
import Ornament from '../components/Ornament.astro';
import FairyIllustration from '../components/FairyIllustration.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import CvDownload from '../components/CvDownload.astro';
import { projetsAccueil as projets } from '../data/projets';
import { site } from '../data/site';
import { Image } from 'astro:assets';
import heroImage from '../../public/images/commun/hero.png';
// Ajoutez votre adresse e-mail pour activer le lien de contact.
const email = site.email;
---

<Layout title="Estelle Coulon — Portfolio créatif">
  <main id="contenu">
    <section class="hero" aria-labelledby="hero-title">
      {!heroImage && (
        <div class="glass-wall" aria-hidden="true">
          {Array.from({ length: 15 }, () => (
            <div class="glass-tile" />
          ))}
        </div>
      )}
      {heroImage && (
        <Image
          class="hero-background"
          src={heroImage}
          alt=""
          width={1920}
          widths={[480, 960, 1440, 1920]}
          sizes="100vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="little-star" aria-hidden="true">
              <Ornament kind="star-violet" width={23} eager />
            </span>{' '}
            Portfolio créatif — 2026
          </p>
          <h1 id="hero-title">
            Estelle <br />
            <span>Coulon</span>
            <span class="title-star" aria-hidden="true">
              <Ornament kind="star-pink" width={60} eager />
            </span>
          </h1>
          <p class="hero-description">
            Design graphique, <br />
            <em>identité visuelle et interfaces.</em>
          </p>
          <p class="hero-role">Étudiante en BUT MMI · Design graphique & interfaces</p>
          <p class="hero-availability">
            Je recherche en priorité une alternance en création numérique ou en communication.
          </p>
          <a class="button button-primary" href="#projets">
            Découvrir mes projets
          </a>
          <SocialLinks />
        </div>
        <div class="hero-art illustration-scene">
          <span class="scene-moon">
            <Ornament kind="moon-blue" width={270} eager />
          </span>
          <span class="scene-star-left">
            <Ornament kind="star-violet" width={48} eager />
          </span>
          <span class="scene-star-right">
            <Ornament kind="star-pink" width={32} />
          </span>
          <FairyIllustration
            variant={4}
            width={460}
            eager
            alt="Fée dessinée par Estelle Coulon"
            class="hero-fairy"
            hint
          />
          <div class="palette" role="img" aria-label="Ma palette : rose, violet, bleu et bordeaux">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>
        <a class="scroll-cue" href="#projets">
          <span>Voir les projets</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>
    <section class="expertise-band container" aria-label="Mes disciplines">
      <p class="expertise-label">Mes disciplines</p>
      <ul class="expertise-list">
        <li>
          Identité <span>visuelle</span>
        </li>
        <li>
          Design <span>graphique</span>
        </li>
        <li>
          UI <span>/ UX</span>
        </li>
        <li>
          Web <span>design</span>
        </li>
      </ul>
    </section>
    <section class="projects-section container" id="projets" aria-labelledby="projects-title">
      <div class="section-heading">
        <span class="section-drawn-star">
          <Ornament kind="star-violet" width={46} />
        </span>
        <div>
          <p class="eyebrow">01 / Une sélection de mon travail</p>
          <h2 id="projects-title">
            Des idées devenues <br />
            <span class="handwritten">des projets.</span>
          </h2>
        </div>
        <p>
          Des univers différents. <br />
          La même envie de créer quelque chose <br />
          qui a du sens et qui se remarque.
        </p>
      </div>
      <div
        class="project-grid"
        id="project-carousel"
        tabindex="0"
        role="region"
        aria-label="Projets sélectionnés"
      >
        {projets.map((projet) => (
          <ProjectCard projet={projet} />
        ))}
      </div>
      <div class="carousel-controls" aria-label="Navigation des projets">
        <span class="carousel-hint">Faites glisser pour explorer</span>
        <div class="carousel-dots">
          {projets.map((projet, index) => (
            <button
              type="button"
              class="carousel-dot"
              aria-label={`Afficher le projet ${projet.nom}`}
              aria-controls="project-carousel"
              aria-current={index === 0 ? 'true' : undefined}
              data-slide={index}
            >
              <span></span>
            </button>
          ))}
        </div>
      </div>
    </section>
    <section class="about-section" id="a-propos" aria-labelledby="about-title">
      <div class="container about-inner">
        <div class="about-fairy">
          <FairyIllustration variant={3} width={300} />
        </div>
        <div>
          <p class="eyebrow">02 / Mon parcours</p>
          <h2 id="about-title">
            Design graphique <br />
            <span class="handwritten">et formation MMI.</span>
          </h2>
          <p>
            Je suis étudiante en deuxième année de BUT Métiers du Multimédia et de l’Internet à
            Montbéliard, après une formation en Métiers de la Mode et du Vêtement.
          </p>
          <p>
            Je travaille sur des identités visuelles, des maquettes d’interfaces et des sites web.
            Mes études de cas présentent mon rôle et les étapes de réalisation de chaque projet.
          </p>
          <div class="skill-tags">
            <span>Identité visuelle</span>
            <span>UI / UX</span>
            <span>Web design</span>
            <span>Intégration web</span>
          </div>
        </div>
      </div>
    </section>
    <section class="contact-section container" id="contact" aria-labelledby="contact-title">
      <p class="eyebrow">03 / Contact</p>
      <h2 id="contact-title">
        Une alternance <br />
        <span class="handwritten">ou un projet ?</span>
        <span class="contact-star" aria-hidden="true">
          <Ornament kind="star-blue" width={58} />
        </span>
      </h2>
      <p>Je recherche en priorité une alternance en création numérique ou en communication.</p>
      {email ? (
        <a class="button button-primary" href={`mailto:${email}`}>
          Écrivez-moi
        </a>
      ) : (
        <p class="contact-pending">Mes coordonnées arrivent bientôt.</p>
      )}
      <CvDownload />
    </section>
  </main>
  <script>
    const track = document.querySelector<HTMLElement>('#project-carousel');
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-slide]'));
    const mobile = window.matchMedia('(max-width: 700px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (track) {
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.project'));
      let frame = 0;
      const update = () => {
        const position = track.getBoundingClientRect().left;
        let closest = 0;
        cards.forEach((card, index) => {
          if (
            Math.abs(card.getBoundingClientRect().left - position) <
            Math.abs(cards[closest].getBoundingClientRect().left - position)
          )
            closest = index;
        });
        dots.forEach((dot, index) => {
          if (index === closest) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
        frame = 0;
      };
      dots.forEach((dot, index) =>
        dot.addEventListener('click', () => {
          if (!mobile.matches) return;
          const shift =
            cards[index].getBoundingClientRect().left - track.getBoundingClientRect().left;
          track.scrollTo({
            left: track.scrollLeft + shift,
            behavior:
              reduced.matches || document.documentElement.dataset.motion === 'off'
                ? 'instant'
                : 'smooth',
          });
        }),
      );
      track.addEventListener(
        'scroll',
        () => {
          if (!frame) frame = requestAnimationFrame(update);
        },
        { passive: true },
      );
      mobile.addEventListener('change', () => {
        track.scrollLeft = 0;
        track.tabIndex = mobile.matches ? 0 : -1;
        update();
      });
      track.tabIndex = mobile.matches ? 0 : -1;
    }
  </script>
</Layout>

<style>
  /* Respiration de l’accueil sur mobile, sans modifier les illustrations. */
  @media (max-width: 700px) {
    .hero-inner {
      padding-top: 136px;
      padding-bottom: 100px;
      gap: 56px;
    }
    .hero .eyebrow {
      margin-bottom: 32px;
    }
    .hero h1 {
      margin-bottom: 42px;
    }
    .hero-description {
      margin-bottom: 24px;
    }
    .hero-role {
      margin-bottom: 24px;
    }
    .hero-availability {
      margin-bottom: 32px;
    }
    .hero-copy :global(.social-cta) {
      margin-top: 28px;
      gap: 12px;
    }
    .expertise-band {
      padding-block: 48px;
    }
    .expertise-label {
      margin-bottom: 28px;
    }
    .expertise-list {
      row-gap: 24px;
    }
    .projects-section {
      padding-block: 72px 80px;
    }
    .section-heading {
      margin-bottom: 42px;
    }
    .section-heading > p {
      margin-top: 28px;
    }
    .carousel-controls {
      margin-top: 28px;
    }
    .about-section {
      padding-block: 64px 72px;
    }
    .about-inner {
      gap: 44px;
    }
    .about-inner h2 {
      margin-bottom: 30px;
    }
    .about-inner p:not(.eyebrow) + p {
      margin-top: 24px;
    }
    .skill-tags {
      margin-top: 30px;
      gap: 10px;
    }
    .contact-section {
      padding-block: 80px;
    }
    .contact-section h2 {
      margin-bottom: 32px;
    }
    .contact-section .button {
      margin-top: 24px;
    }
  }
</style>
